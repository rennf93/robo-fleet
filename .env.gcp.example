# RoboFleet on GCP - environment template for the Cloud Run services.
# Copy to .env.gcp and fill in values from `terraform output` and Secret
# Manager. This mirrors what infra/orchestrator-service.yaml and
# infra/panel-service.yaml actually set (see docs/deploy.md and
# docs/configuration.md) - it is a reference for hand-testing or adapting
# the deploy, not something the deploy scripts read directly (they
# sed-substitute the YAML manifests, not this file).
# Plain hyphens only, no em-dashes. Every var is documented inline.

# --- Bind (Cloud Run requires 0.0.0.0; the config default is 127.0.0.1) ---
ROBOFLEET_HOST=0.0.0.0
ROBOFLEET_PORT=8000

# --- Database (Cloud SQL Postgres 16) ---
# Two independent connection paths read these, both required:
#   1. The async runtime engine (every normal request) uses the Cloud SQL
#      Python Connector when ROBOFLEET_GCP_CLOUDSQL_INSTANCE (below) is
#      set - it dials by connection name over the private IP and ignores
#      HOST/PORT entirely for that path.
#   2. The boot-time Alembic migration (robofleet/db/base.py: run_migrations)
#      always connects with the plain host/port DSN below, so HOST must
#      still be the real reachable Cloud SQL private IP
#      (`terraform output cloudsql_private_ip`), reachable only over the
#      Serverless VPC Access connector - there is no Cloud SQL Auth Proxy
#      sidecar in this deploy.
ROBOFLEET_DATABASE_HOST=
ROBOFLEET_DATABASE_PORT=5432
ROBOFLEET_DATABASE_USER=robofleet
# From Secret Manager secret robofleet-database-password (seeded by
# seed-secrets.sh) - must match the google_sql_user password in
# infra/terraform.tfvars. Never commit a real value.
ROBOFLEET_DATABASE_PASSWORD=
ROBOFLEET_DATABASE_NAME=robofleet

# --- Redis (Memorystore for Redis 7.x, BASIC tier, NO AUTH) ---
# infra/main.tf provisions this instance with auth_enabled = false (private-
# VPC-only containment is the only gate - see the ponytail: comment there),
# so ROBOFLEET_REDIS_PASSWORD stays empty on this deploy. Set it only if you
# provision Memorystore with AUTH enabled yourself.
# Run `terraform output memorystore_host` for the IP.
ROBOFLEET_REDIS_HOST=
ROBOFLEET_REDIS_PORT=6379
ROBOFLEET_REDIS_PASSWORD=
ROBOFLEET_REDIS_DB=0

# --- GCP infra references (from terraform output) ---
# Setting ROBOFLEET_GCP_PROJECT_ID is the "GCP is armed" signal: it also
# moves the agent-auth secret and per-agent spawn credentials from env vars
# to Secret Manager, and switches agent Jobs to Vertex-AI auth (see below).
ROBOFLEET_GCP_PROJECT_ID=
ROBOFLEET_GCP_REGION=
# Cloud SQL instance connection name (project:region:instance). Arms the
# Cloud SQL Python Connector for the async runtime engine (see above).
ROBOFLEET_GCP_CLOUDSQL_INSTANCE=
# Memorystore host + port (port is 6379 unless you changed it).
ROBOFLEET_GCP_MEMORYSTORE_HOST=
ROBOFLEET_GCP_MEMORYSTORE_PORT=6379
# The reference Memorystore instance has no TLS listener (BASIC tier, no
# AUTH). Leaving this at the config default (true) builds a rediss:// URL
# that TLS-handshakes a plaintext port and hangs - must be false here.
ROBOFLEET_GCP_MEMORYSTORE_TLS=false
# Filestore NFS share mounted at /data/workspaces.
ROBOFLEET_GCP_FILESTORE_SHARE=workspaces
# Filestore server IP + export path and the Serverless VPC Access connector:
# the orchestrator attaches them as the NFS volume + connector of every agent
# Cloud Run Job (a developer Job whose working dir is on the share refuses to
# spawn without them). `terraform output filestore_ip`, `/<filestore_share>`,
# and `projects/<project>/locations/<region>/connectors/<vpc_connector_name>`.
ROBOFLEET_GCP_FILESTORE_IP=
ROBOFLEET_GCP_FILESTORE_NFS_PATH=/workspaces
ROBOFLEET_GCP_VPC_CONNECTOR_NAME=
# Vertex AI location for the agent model, separate from the Job region above.
# gemini-3.5-flash is served from the global endpoint; regional availability
# was preview-only through Aug 2026. Empty falls back to ROBOFLEET_GCP_REGION.
ROBOFLEET_GCP_VERTEX_MODEL_LOCATION=global
ROBOFLEET_GCP_GCS_BUCKET=
ROBOFLEET_GCP_ARTIFACT_REGISTRY_REPO=robo-fleet
# Prefix used by seed-secrets.sh (default robofleet).
ROBOFLEET_GCP_SECRET_MANAGER_PREFIX=robofleet
# Cloud Run job name prefix for spawned agent containers.
ROBOFLEET_GCP_CLOUD_RUN_AGENT_JOB_PREFIX=robofleet-agent

# --- Secrets (from Secret Manager, pulled at runtime) ---
# Fernet key from secret robofleet-fernet-key.
ROBOFLEET_ENCRYPTION_KEY=
# Agent auth HMAC secret from secret robofleet-agent-auth-secret. Read
# directly via os.environ, not the Settings model (robofleet/agents_config.py)
# - when ROBOFLEET_GCP_PROJECT_ID is set this is instead fetched once from
# Secret Manager and this var is unused, but it's still what
# infra/orchestrator-service.yaml wires as a secretKeyRef.
ROBOFLEET_AGENT_AUTH_SECRET=
# Also read directly via os.environ (robofleet/api/deps.py), not the
# Settings model.
ROBOFLEET_AGENT_AUTH_REQUIRED=true

# --- Cloud auth (armed on GCP - panel is publicly reachable, no nginx or
# private network in front of it) ---
ROBOFLEET_CLOUD_AUTH_ENABLED=true
# From secret robofleet-cloud-auth-secret.
ROBOFLEET_CLOUD_AUTH_SECRET=
# Seeded CEO login (set once, rotate via the panel or seed-secrets.sh).
ROBOFLEET_CLOUD_AUTH_EMAIL=
ROBOFLEET_CLOUD_AUTH_PASSWORD=

# --- URLs ---
# Public panel URL once the Cloud Run service is deployed
# (https://robofleet-panel-<project-number>.<region>.run.app).
ROBOFLEET_PUBLIC_BASE_URL=
# ROBOFLEET_API_URL / _ORCHESTRATOR_URL: on the ORCHESTRATOR service this
# must be the service's OWN public Cloud Run URL (Cloud Run v2 URLs are
# deterministic from the project number + region + service name, so this
# can be computed before the service is first deployed - see deploy.md
# step 4) - the orchestrator's own self-calls and every spawned agent Job's
# callback both resolve from this, and localhost is unreachable from a
# separate Job container. On the PANEL service, deploy-panel.sh instead
# sets both to the already-deployed ORCHESTRATOR's public URL (discovered
# via `gcloud run services describe`); the panel's proxy.ts forwards
# /api/* there at request time.
ROBOFLEET_API_URL=https://robofleet-orchestrator-<project-number>.<region>.run.app
ROBOFLEET_ORCHESTRATOR_URL=https://robofleet-orchestrator-<project-number>.<region>.run.app

# --- Agent images (Artifact Registry) ---
# Run `terraform output artifact_registry_repo` for the repo id.
ROBOFLEET_AGENT_IMAGE_REGISTRY=
ROBOFLEET_AGENT_IMAGE_TAG=latest
# No docker socket on Cloud Run: skip the startup docker pull/build of
# agent images. Agents spawn as Cloud Run Jobs that pull the registry image
# by name on their own execution instead.
ROBOFLEET_AGENT_IMAGE_SKIP_ENSURE=true

# --- Validator / local LLM ---
# No Ollama sidecar exists on Cloud Run, so this deliberately points at an
# unreachable localhost - local-model features (RAG answer synthesis,
# org-memory lesson distillation) fail best-effort and silently no-op
# rather than blocking anything. _ALLOW_EXTERNAL is set true only because
# the validator would otherwise reject a non-internal host; it does not
# make this endpoint reachable. Point ROBOFLEET_LOCAL_LLM_BASE_URL at a real
# externally-reachable Ollama endpoint if you want these features live.
ROBOFLEET_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
ROBOFLEET_LOCAL_LLM_BASE_URL_ALLOW_EXTERNAL=true
ROBOFLEET_LOCAL_LLM_MODEL=gemini-2.5-flash

# --- Agent model (ADK agent runtime on Cloud Run Jobs) ---
# Read directly via os.environ in robofleet/llm/providers/cloudrun_jobs.py,
# not the Settings model - injected into every agent Job as
# ROBOFLEET_AGENT_MODEL. The hackathon requires Gemini 3.5+.
ROBOFLEET_AGENT_MODEL_DEFAULT=gemini-3.5-flash

# --- Gemini API key (fallback auth only) ---
# From Secret Manager secret robofleet-gemini-api-key; infra/seed-secrets.sh
# seeds it unconditionally, and the config validator wants it set. BUT with
# ROBOFLEET_GCP_PROJECT_ID set (as above), agent Jobs actually authenticate
# to Vertex AI via the Cloud Run Job's own runtime service account
# (GOOGLE_GENAI_USE_VERTEXAI=1 + GOOGLE_CLOUD_PROJECT/_LOCATION), billing this
# project's own credit - this key is only forwarded as GEMINI_API_KEY when
# ROBOFLEET_GCP_PROJECT_ID is unset. Keep it set anyway: seed-secrets.sh
# requires it, and it's what the local-dev docker-run spawn path uses.
ROBOFLEET_GEMINI_API_KEY=

# --- Feature flags armed for the GCP hackathon deploy ---
# Org memory loop - useful for the demo, runs on the local model.
ROBOFLEET_ORG_MEMORY_ENABLED=true
# Toolchain match relies on the docker socket - off on Cloud Run; sandbox
# services (if used) replace it.
ROBOFLEET_TOOLCHAIN_MATCH_ENABLED=false
# Gateway-health recovery - safe on Cloud Run, no docker socket needed.
ROBOFLEET_GATEWAY_HEALTH_ENABLED=true
# Overload break - parks the provider on 429/529 instead of crash-respawning.
ROBOFLEET_OVERLOAD_BREAK_ENABLED=true
# Task/project cost caps (tasks.budget_usd, projects.monthly_budget_usd): a
# breach blocks the task before the graceful stop, so a looping agent cannot
# burn credits. Set the caps on the project/task in the panel; null = no cap.
ROBOFLEET_TASK_BUDGETS_ENABLED=true

# --- Feature flags deliberately OFF on GCP (docker-socket or local-only) ---
# Self-heal, CI-watch, dep-update, docs-sync, release manager, video engine,
# Telegram bridge, env-sync, sandbox DB, X account, Fable-mode, possibilities
# matrix, and the Board Program cron loops all default OFF here. Enable
# individually once their GCP-compatible backend is wired.
# ROBOFLEET_SELF_HEAL_ENABLED=false
# ROBOFLEET_CI_WATCH_ENABLED=false
# ROBOFLEET_DEP_UPDATE_ENABLED=false
# ROBOFLEET_DOCS_SYNC_ENABLED=false
# ROBOFLEET_RELEASE_MANAGER_ENABLED=false
# ROBOFLEET_VIDEO_ENGINE_ENABLED=false
# ROBOFLEET_TELEGRAM_ENABLED=false
# ROBOFLEET_ENV_SYNC_ENABLED=false
# ROBOFLEET_SANDBOX_DB_ENABLED=false
# ROBOFLEET_X_ENGINE_ENABLED=false
# ROBOFLEET_FABLE_MODE_ENABLED=false
# ROBOFLEET_POSSIBILITIES_MATRIX_ENABLED=false
