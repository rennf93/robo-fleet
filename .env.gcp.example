# RoboCo on GCP - environment template for the Cloud Run services.
# Copy to .env.gcp and fill in values from `terraform output` and Secret Manager.
# Plain hyphens only, no em-dashes. Every var is documented inline.

# --- Database (Cloud SQL Postgres 16) ---
# Host is the Cloud SQL Auth Proxy sidecar (Unix socket or 127.0.0.1:5432).
# Run `terraform output cloudsql_connection_name` for the instance connection name.
ROBOCO_DATABASE_HOST=127.0.0.1
ROBOCO_DATABASE_PORT=5432
ROBOCO_DATABASE_USER=roboco
# From Secret Manager secret roboco-... (set by seed-secrets.sh) - or the
# google_sql_user password var. Never commit a real value.
ROBOCO_DATABASE_PASSWORD=
ROBOCO_DATABASE_NAME=roboco

# --- Redis (Memorystore for Redis 7.x, AUTH enabled) ---
# Run `terraform output memorystore_host` for the IP.
ROBOCO_REDIS_HOST=
ROBOCO_REDIS_PORT=6379
# Memorystore AUTH token - rotate via gcloud and store in Secret Manager.
ROBOCO_REDIS_PASSWORD=
ROBOCO_REDIS_DB=0

# --- GCP infra references (from terraform output) ---
ROBOCO_GCP_PROJECT_ID=
ROBOCO_GCP_REGION=
# Cloud SQL instance connection name (project:region:instance).
ROBOCO_GCP_CLOUDSQL_INSTANCE=
# Memorystore host + port (port is 6379 unless you changed it).
ROBOCO_GCP_MEMORISTORE_HOST=
ROBOCO_GCP_MEMORISTORE_PORT=6379
# Filestore NFS share mounted at /data/workspaces.
ROBOCO_GCP_FILESTORE_SHARE=workspaces
ROBOCO_GCP_GCS_BUCKET=
ROBOCO_GCP_ARTIFACT_REGISTRY_REPO=robo-fleet
# Prefix used by seed-secrets.sh (default roboco).
ROBOCO_GCP_SECRET_MANAGER_PREFIX=roboco
# Cloud Run job name prefix for spawned agent containers.
ROBOCO_GCP_CLOUD_RUN_AGENT_JOB_PREFIX=roboco-agent

# --- Secrets (from Secret Manager, pulled at runtime) ---
# Fernet key from secret roboco-fernet-key.
ROBOCO_ENCRYPTION_KEY=
# Agent auth HMAC secret from secret roboco-agent-auth-secret.
ROBOCO_AGENT_AUTH_SECRET=
ROBOCO_AGENT_AUTH_REQUIRED=true

# --- Cloud auth (armed on GCP - panel is publicly reachable) ---
ROBOCO_CLOUD_AUTH_ENABLED=true
# From secret roboco-cloud-auth-secret.
ROBOCO_CLOUD_AUTH_SECRET=
# Seeded CEO login (set once, rotate via the panel or seed-secrets.sh).
ROBOCO_CLOUD_AUTH_EMAIL=
ROBOCO_CLOUD_AUTH_PASSWORD=

# --- URLs ---
# Public panel hostname once the Cloud Run service is deployed.
ROBOCO_PUBLIC_BASE_URL=https://roboco.run.app
# Internal orchestrator URL (same container, localhost).
ROBOCO_API_URL=http://localhost:8000
ROBOCO_ORCHESTRATOR_URL=http://localhost:8000

# --- Agent images (Artifact Registry) ---
# Run `terraform output artifact_registry_repo` for the repo id.
ROBOCO_AGENT_IMAGE_REGISTRY=
ROBOCO_AGENT_IMAGE_TAG=latest

# --- Validator / local LLM ---
# Allow the agent image to reach the external LLM endpoint (Gemini API).
ROBOCO_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
ROBOCO_LOCAL_LLM_BASE_URL_ALLOW_EXTERNAL=true
ROBOCO_LOCAL_LLM_MODEL=gemini-2.5-flash

# --- Gemini API key (for the agent / validator LLM calls) ---
# From secret roboco-gemini-api-key. Only needed if the orchestrator or
# agents call Gemini directly instead of through the local proxy.
ROBOCO_GEMINI_API_KEY=

# --- Feature flags armed for the GCP hackathon deploy ---
# Org memory loop - useful for the demo, runs on the local model.
ROBOCO_ORG_MEMORY_ENABLED=true
# Toolchain match relies on the docker socket - off on Cloud Run; sandbox
# services (if used) replace it.
ROBOCO_TOOLCHAIN_MATCH_ENABLED=false
# Gateway-health recovery - safe on Cloud Run, no docker socket needed.
ROBOCO_GATEWAY_HEALTH_ENABLED=true
# Overload break - parks the provider on 429/529 instead of crash-respawning.
ROBOCO_OVERLOAD_BREAK_ENABLED=true

# --- Feature flags deliberately OFF on GCP (docker-socket or local-only) ---
# Self-heal, CI-watch, dep-update, docs-sync, release manager, video engine,
# Telegram bridge, env-sync, sandbox DB, X account, Fable-mode, possibilities
# matrix, and the Board Program cron loops all default OFF here. Enable
# individually once their GCP-compatible backend is wired.
# ROBOCO_SELF_HEAL_ENABLED=false
# ROBOCO_CI_WATCH_ENABLED=false
# ROBOCO_DEP_UPDATE_ENABLED=false
# ROBOCO_DOCS_SYNC_ENABLED=false
# ROBOCO_RELEASE_MANAGER_ENABLED=false
# ROBOCO_VIDEO_ENGINE_ENABLED=false
# ROBOCO_TELEGRAM_ENABLED=false
# ROBOCO_ENV_SYNC_ENABLED=false
# ROBOCO_SANDBOX_DB_ENABLED=false
# ROBOCO_X_ENGINE_ENABLED=false
# ROBOCO_FABLE_MODE_ENABLED=false
# ROBOCO_POSSIBILITIES_MATRIX_ENABLED=false