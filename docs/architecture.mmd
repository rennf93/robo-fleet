flowchart TD
    subgraph Judges["Judge / CEO (browser)"]
        Panel["robo-fleet panel<br/>Next.js 16 on Cloud Run"]
    end

    subgraph Orch["robo-fleet orchestrator (Cloud Run service)"]
        API["FastAPI API + WebSocket"]
        Choreographer["Choreographer<br/>flow / do v1 routes"]
        Dispatch["Orchestrator dispatcher<br/>CloudRunJobsProvider"]
        Services["TaskService / GitService<br/>MetricsService / AuditLog"]
    end

    subgraph Agent["Agent runtime (Cloud Run Job, one per task)"]
        ADK["ADK Runner + LlmAgent<br/>robofleet.agent.adk_entry"]
        Shim["Gateway tool-shim<br/>+ git/file FunctionTools"]
    end

    Gemini["Gemini 3.5 Flash<br/>Gemini API / Vertex AI"]

    subgraph Data["GCP infra"]
        CloudSQL["Cloud SQL Postgres 16<br/>+ pgvector (memory bank, audit_log)"]
        Memorystore["Memorystore for Redis 7.x<br/>cache + rate-limit state"]
        Filestore["Filestore NFS<br/>agent git workspaces"]
        GCS["GCS bucket<br/>tool manifests + agent clones"]
        SM["Secret Manager<br/>Fernet key, HMAC secret, Gemini key"]
        AR["Artifact Registry<br/>3 images built by Cloud Build"]
    end

    Panel -->|"api / ws"| API
    API --> Choreographer
    Choreographer --> Services
    Dispatch -->|"submit Cloud Run Job execution"| ADK
    ADK --> Shim
    ADK -->|"generate"| Gemini
    Shim -->|"http /api/v1/flow, /api/v1/do"| API
    Services --> CloudSQL
    Services --> Memorystore
    Services --> Filestore
    Dispatch -->|"upload manifest + clone"| GCS
    ADK -->|"fetch manifest + clone"| GCS
    API --> SM
    ADK -->|"pull Gemini API key"| SM
    Dispatch -->|"pull image"| AR

    classDef gcp fill:#e8f0fe,stroke:#4285f4,stroke-width:2px,color:#1a1a1a
    class CloudSQL,Memorystore,Filestore,GCS,SM,AR gcp