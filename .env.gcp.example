# RoboFleet on GCP - environment template for the Cloud Run services.
# Copy to .env.gcp and fill in values from `terraform output` and Secret Manager.
# Plain hyphens only, no em-dashes. Every var is documented inline.

# --- Database (Cloud SQL Postgres 16) ---
# Host is the Cloud SQL Auth Proxy sidecar (Unix socket or 127.0.0.1:5432).
# Run `terraform output cloudsql_connection_name` for the instance connection name.
ROBOFLEET_DATABASE_HOST=127.0.0.1
ROBOFLEET_DATABASE_PORT=5432
ROBOFLEET_DATABASE_USER=robofleet
# From Secret Manager secret robofleet-... (set by seed-secrets.sh) - or the
# google_sql_user password var. Never commit a real value.
ROBOFLEET_DATABASE_PASSWORD=
ROBOFLEET_DATABASE_NAME=robofleet

# --- Redis (Memorystore for Redis 7.x, AUTH enabled) ---
# Run `terraform output memorystore_host` for the IP.
ROBOFLEET_REDIS_HOST=
ROBOFLEET_REDIS_PORT=6379
# Memorystore AUTH token - rotate via gcloud and store in Secret Manager.
ROBOFLEET_REDIS_PASSWORD=
ROBOFLEET_REDIS_DB=0

# --- GCP infra references (from terraform output) ---
ROBOFLEET_GCP_PROJECT_ID=
ROBOFLEET_GCP_REGION=
# Cloud SQL instance connection name (project:region:instance).
ROBOFLEET_GCP_CLOUDSQL_INSTANCE=
# Memorystore host + port (port is 6379 unless you changed it).
ROBOFLEET_GCP_MEMORYSTORE_HOST=
ROBOFLEET_GCP_MEMORYSTORE_PORT=6379
# Filestore NFS share mounted at /data/workspaces.
ROBOFLEET_GCP_FILESTORE_SHARE=workspaces
# Filestore server IP + export path and the Serverless VPC Access connector:
# the orchestrator attaches them as the NFS volume + connector of every agent
# Cloud Run Job (a developer Job whose working dir is on the share refuses to
# spawn without them). `terraform output filestore_ip`, `/<filestore_share>`,
# and `projects/<project>/locations/<region>/connectors/<vpc_connector_name>`.
ROBOFLEET_GCP_FILESTORE_IP=
ROBOFLEET_GCP_FILESTORE_NFS_PATH=/workspaces
ROBOFLEET_GCP_VPC_CONNECTOR_NAME=
# Vertex AI location for the agent model, separate from the Job region above.
# gemini-3.5-flash is served from the global endpoint; regional availability
# was preview-only through Aug 2026. Empty falls back to ROBOFLEET_GCP_REGION.
ROBOFLEET_GCP_VERTEX_MODEL_LOCATION=global
ROBOFLEET_GCP_GCS_BUCKET=
ROBOFLEET_GCP_ARTIFACT_REGISTRY_REPO=robo-fleet
# Prefix used by seed-secrets.sh (default robofleet)..
ROBOFLEET_GCP_SECRET_MANAGER_PREFIX=robofleet
# Cloud Run job name prefix for spawned agent containers.
ROBOFLEET_GCP_CLOUD_RUN_AGENT_JOB_PREFIX=robofleet-agent

# --- Secrets (from Secret Manager, pulled at runtime) ---
# Fernet key from secret robofleet-fernet-key.
ROBOFLEET_ENCRYPTION_KEY=
# Agent auth HMAC secret from secret robofleet-agent-auth-secret.
ROBOFLEET_AGENT_AUTH_SECRET=
ROBOFLEET_AGENT_AUTH_REQUIRED=true

# --- Cloud auth (armed on GCP - panel is publicly reachable) ---
ROBOFLEET_CLOUD_AUTH_ENABLED=true
# From secret robofleet-cloud-auth-secret.
ROBOFLEET_CLOUD_AUTH_SECRET=
# Seeded CEO login (set once, rotate via the panel or seed-secrets.sh).
ROBOFLEET_CLOUD_AUTH_EMAIL=
ROBOFLEET_CLOUD_AUTH_PASSWORD=

# --- URLs ---
# Public panel URL once the Cloud Run service is deployed
# (https://robofleet-panel-<project-number>.<region>.run.app).
ROBOFLEET_PUBLIC_BASE_URL=
# On the ORCHESTRATOR service: its own URL (same container, localhost). On the
# PANEL service deploy-panel.sh sets both to the orchestrator's public Cloud
# Run URL; the panel's proxy.ts forwards /api/* there at request time.
ROBOFLEET_API_URL=http://localhost:8000
ROBOFLEET_ORCHESTRATOR_URL=http://localhost:8000

# --- Agent images (Artifact Registry) ---
# Run `terraform output artifact_registry_repo` for the repo id.
ROBOFLEET_AGENT_IMAGE_REGISTRY=
ROBOFLEET_AGENT_IMAGE_TAG=latest

# --- Validator / local LLM ---
# Allow the agent image to reach the external LLM endpoint (Gemini API).
ROBOFLEET_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
ROBOFLEET_LOCAL_LLM_BASE_URL_ALLOW_EXTERNAL=true
ROBOFLEET_LOCAL_LLM_MODEL=gemini-2.5-flash

# --- Agent model (ADK agent runtime on Cloud Run Jobs) ---
# Injected into every agent Job as ROBOFLEET_AGENT_MODEL. The hackathon
# requires Gemini 3.5+; the Jobs authenticate to Vertex AI with the compute
# service account (GOOGLE_GENAI_USE_VERTEXAI=1), not this key.
ROBOFLEET_AGENT_MODEL_DEFAULT=gemini-3.5-flash

# --- Gemini API key (ADK agent runtime on Cloud Run Jobs) ---
# From Secret Manager secret robofleet-gemini-api-key. Required: the
# orchestrator forwards this as GEMINI_API_KEY into every agent Cloud Run Job
# so the ADK LlmAgent can authenticate to the Gemini API. Set it as a Cloud Run
# env-secret on the orchestrator service. Without it the agent container cannot
# call the model.
ROBOFLEET_GEMINI_API_KEY=

# --- Feature flags armed for the GCP hackathon deploy ---
# Org memory loop - useful for the demo, runs on the local model.
ROBOFLEET_ORG_MEMORY_ENABLED=true
# Toolchain match relies on the docker socket - off on Cloud Run; sandbox
# services (if used) replace it.
ROBOFLEET_TOOLCHAIN_MATCH_ENABLED=false
# Gateway-health recovery - safe on Cloud Run, no docker socket needed.
ROBOFLEET_GATEWAY_HEALTH_ENABLED=true
# Overload break - parks the provider on 429/529 instead of crash-respawning.
ROBOFLEET_OVERLOAD_BREAK_ENABLED=true
# Task/project cost caps (tasks.budget_usd, projects.monthly_budget_usd): a
# breach blocks the task before the graceful stop, so a looping agent cannot
# burn credits. Set the caps on the project/task in the panel; null = no cap.
ROBOFLEET_TASK_BUDGETS_ENABLED=true

# --- Feature flags deliberately OFF on GCP (docker-socket or local-only) ---
# Self-heal, CI-watch, dep-update, docs-sync, release manager, video engine,
# Telegram bridge, env-sync, sandbox DB, X account, Fable-mode, possibilities
# matrix, and the Board Program cron loops all default OFF here. Enable
# individually once their GCP-compatible backend is wired.
# ROBOFLEET_SELF_HEAL_ENABLED=false
# ROBOFLEET_CI_WATCH_ENABLED=false
# ROBOFLEET_DEP_UPDATE_ENABLED=false
# ROBOFLEET_DOCS_SYNC_ENABLED=false
# ROBOFLEET_RELEASE_MANAGER_ENABLED=false
# ROBOFLEET_VIDEO_ENGINE_ENABLED=false
# ROBOFLEET_TELEGRAM_ENABLED=false
# ROBOFLEET_ENV_SYNC_ENABLED=false
# ROBOFLEET_SANDBOX_DB_ENABLED=false
# ROBOFLEET_X_ENGINE_ENABLED=false
# ROBOFLEET_FABLE_MODE_ENABLED=false
# ROBOFLEET_POSSIBILITIES_MATRIX_ENABLED=false