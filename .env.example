# =============================================================================
# RoboFleet Environment Configuration
# =============================================================================
# Copy this file to .env. This covers the LOCAL / SELF-HOSTED deploy shape:
# plain `uv run` / `make dev`, and docker-compose.yml / .yaml / .registry.yml
# (the two non-registry files are kept byte-identical, see the Makefile's
# `compose-sync` gate). For the GCP Cloud Run deploy path used for the
# hackathon demo, use .env.gcp.example instead (see docs/deploy.md).
#
# This deploy shape's agent containers use Claude Code CLI authentication,
# not an API key - run `claude` on the host once to authenticate before
# starting RoboFleet. The GCP path (.env.gcp.example) uses Gemini instead.
#
# Every var a compose file references is listed below; unreferenced vars
# have no effect on that deploy shape even if set. Full reference (every
# setting in robofleet/config.py, grouped, with defaults): docs/configuration.md

# =============================================================================
# Container-to-host bind mounts (only for docker compose on a remote server)
# =============================================================================
# These are REQUIRED when running via docker compose on a server you don't
# also develop on. They tell the orchestrator container where to find files
# on the HOST (must be ABSOLUTE paths - the orchestrator bind-mounts them
# into spawned agent containers).

# Path to this project on the host (absolute path)
# ROBOFLEET_HOST_PROJECT_DIR=/opt/robofleet

# Host path mirroring ROBOFLEET_DATA_DIR (see below), used when the orchestrator
# needs the HOST-side path for a bind mount it hands to a spawned container.
# ROBOFLEET_HOST_DATA_DIR=/opt/robofleet/data

# Public base URL for commit-trailer links (e.g. LAN IP or domain) — default
# 127.0.0.1 produces unusable links in commit message bodies.
# ROBOFLEET_PUBLIC_BASE_URL=http://localhost:8000

# =============================================================================
# Container Images (docker-compose.registry.yml — pre-built deployment)
# =============================================================================
# Only used by docker-compose.registry.yml, which runs the published images
# instead of building from source. Defaults shown.
# Registry namespace: ghcr.io/rennf93 (GHCR) or docker.io/renzof93 (Docker Hub)
# ROBOFLEET_REGISTRY=ghcr.io/rennf93
# Image tag: latest, or a pinned release such as 0.5.0
# ROBOFLEET_VERSION=latest

# =============================================================================
# Data Persistence
# =============================================================================
# Path to the data directory on the host (MUST be absolute for Docker-in-Docker)
# ROBOFLEET_DATA_DIR=/opt/robofleet/data

# Off-disk mirror for the daily pg_dump backups. Point at a path on a
# DIFFERENT disk (external drive, or a mounted remote/cloud share) — a
# same-disk mirror protects nothing. Unset = mirroring off.
# ROBOFLEET_BACKUP_MIRROR_DIR=/mnt/external/robofleet-backups

# =============================================================================
# Application
# =============================================================================
ROBOFLEET_ENVIRONMENT=development
ROBOFLEET_DEBUG=true

# =============================================================================
# API Server
# =============================================================================
ROBOFLEET_HOST=0.0.0.0
ROBOFLEET_PORT=8000

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# For docker compose deployment, use the container name:
#   ROBOFLEET_DATABASE_HOST=robofleet-postgres
# For local (non-container) development:
ROBOFLEET_DATABASE_HOST=localhost
ROBOFLEET_DATABASE_PORT=5432
ROBOFLEET_DATABASE_USER=robofleet
ROBOFLEET_DATABASE_PASSWORD=robofleet
ROBOFLEET_DATABASE_NAME=robofleet
ROBOFLEET_DATABASE_ECHO=false

# =============================================================================
# Redis
# =============================================================================
# For docker compose deployment, use the container name:
#   ROBOFLEET_REDIS_HOST=robofleet-redis
# For local (non-container) development:
ROBOFLEET_REDIS_HOST=localhost
ROBOFLEET_REDIS_PORT=6379
ROBOFLEET_REDIS_DB=0
# ROBOFLEET_REDIS_PASSWORD=

# =============================================================================
# Cost budgets — optional
# =============================================================================
# Per-task (tasks.budget_usd) and per-project (projects.monthly_budget_usd)
# cost caps. Default-off subsystem; also toggleable on the panel's Feature
# Flags card. A breached task is BLOCKED (not silently killed) and the CEO is
# notified. Build compose arms it true; registry compose leaves it false.
# ROBOFLEET_TASK_BUDGETS_ENABLED=false

# =============================================================================
# Notification re-escalation backoff — optional tuning
# =============================================================================
# Expired unacked ack-required notifications re-escalate on exponential backoff
# (first at expiry, then doubling from the base, capped at 24h) up to a max
# count, instead of re-firing every sweep tick. No panel UI — env/compose is
# the only tuning path.
# ROBOFLEET_NOTIFICATION_REESCALATION_BASE_SECONDS=3600
# ROBOFLEET_NOTIFICATION_MAX_REESCALATIONS=5

# =============================================================================
# Security
# =============================================================================
# Encryption key for git tokens at rest (Fernet). REQUIRED — the orchestrator
# refuses to start without it. Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ROBOFLEET_ENCRYPTION_KEY=

# Agent auth: HMAC secret that signs X-Agent-Token. REQUIRED for docker compose.
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
ROBOFLEET_AGENT_AUTH_SECRET=

# Secure mode. On a trusted network you can leave this false (header-trust
# mode). Set true to require every request to carry a valid token so an
# agent cannot spoof another agent's role. When true you MUST also set
# ROBOFLEET_PANEL_AGENT_TOKEN.
ROBOFLEET_AGENT_AUTH_REQUIRED=false

# The control panel's CEO token, injected by nginx in secure mode so the human
# UI keeps working without the browser holding the signing secret. Generate it
# (after setting ROBOFLEET_AGENT_AUTH_SECRET above) with:  make panel-token
# NOTE: leave this UNSET if you arm cloud auth (below) for real remote exposure —
# it is itself a valid CEO credential that would bypass the login page.
ROBOFLEET_PANEL_AGENT_TOKEN=

# DB network isolation: true when your compose topology puts postgres/redis on
# a data-only network unreachable from agent containers (both docker-compose.yml
# and docker-compose.registry.yml ship this true — it must always travel with
# that networks: topology; flip false only if you removed the isolation).
ROBOFLEET_DB_NETWORK_ISOLATED=true

# =============================================================================
# Cloud auth (panel login, FastAPI Users) — off by default in config;
# armed ON by default in the build compose (docker-compose.yaml/.yml), OFF by
# default in docker-compose.registry.yml
# =============================================================================
# When on, the orchestrator REFUSES TO START unless ROBOFLEET_CLOUD_AUTH_SECRET is
# set, the panel requires a login, and the session cookie is secure-only (needs
# TLS in front of nginx).
# ROBOFLEET_CLOUD_AUTH_ENABLED=false
#
# To test-deploy the build compose before you've set up creds + TLS, turn it
# off for that run:  ROBOFLEET_CLOUD_AUTH_ENABLED=false
#
# To ARM it: set all three below + terminate TLS in front of nginx + leave
# ROBOFLEET_PANEL_AGENT_TOKEN unset.
#   ROBOFLEET_CLOUD_AUTH_SECRET — session-signing key. REQUIRED when enabled.
#     Generate: python -c 'import secrets; print(secrets.token_hex(32))'
#   ROBOFLEET_CLOUD_AUTH_EMAIL / _PASSWORD — the single seeded login (no signup).
# ROBOFLEET_CLOUD_AUTH_SECRET=
# ROBOFLEET_CLOUD_AUTH_EMAIL=
# ROBOFLEET_CLOUD_AUTH_PASSWORD=
# Session cookie lifetime in seconds (default 30 days, sliding — an active
# session never expires, only genuine inactivity past this window logs out).
# ROBOFLEET_CLOUD_AUTH_COOKIE_MAX_AGE=2592000

# =============================================================================
# Telegram notifications bridge — V1 (outbound DMs) / V2 (inbound commands) /
# V3 (Mini App sign-in). The build compose (docker-compose.yaml) arms all
# three by DEFAULT per the arm-new-flags convention; set false here to opt
# out. Inert without stored bot-token + chat-id credentials (set via the
# panel, not env) regardless of these flags. Config-code default (no
# compose) is OFF.
# =============================================================================
# ROBOFLEET_TELEGRAM_ENABLED=true
# V2: inbound commands + actionable approve/reject buttons. Sub-switch on top
# of ROBOFLEET_TELEGRAM_ENABLED above — arming this alone does nothing.
# ROBOFLEET_TELEGRAM_INBOUND_ENABLED=true
# V3: Telegram Mini App sign-in — mints a cloud-auth session cookie for the
# CEO's phone. Requires ROBOFLEET_CLOUD_AUTH_ENABLED=true (startup fails loud
# otherwise — a cloud-auth-off .env must set this false too) AND a public
# HTTPS origin (Mini Apps only open over https).
# ROBOFLEET_TELEGRAM_MINIAPP_ENABLED=true

# =============================================================================
# Model routing strictness
# =============================================================================
# Fail-closed routing: a spawn whose configured provider is disabled RAISES
# instead of degrading to the legacy Claude path. Off (default) => graceful
# degradation with a warning. Audit the model_assignments table before arming
# (a stale row pointing at a disabled provider crashes that spawn).
# ROBOFLEET_ROUTING_STRICT=false

# Spawn preflight: refuse a non-gateway delivery role that would respawn
# forever. Inert in practice (every real delivery role is gateway-enabled).
# ROBOFLEET_SPAWN_PREFLIGHT_ENABLED=false

# =============================================================================
# fastapi-guard HTTP security layer (fastapi-guard 7.6.0 / guard-core 3.12.0)
# =============================================================================
# Master switch + calibration knobs. Off by default; the build compose arms
# it in ACTIVE enforcement. Not exposed on the panel's Feature Flags card
# (compose/env-coupled, like ROBOFLEET_DB_NETWORK_ISOLATED).
# ROBOFLEET_GUARD_ENABLED=false
# Detect-and-log without blocking.
# ROBOFLEET_GUARD_PASSIVE_MODE=true
# Fail CLOSED on an internal guard error (true) vs fail open (false).
# ROBOFLEET_GUARD_FAIL_SECURE=true
# Exact IP address(es), never a range, trusted as an XFF proxy hop beyond loopback
# (a CIDR entry is rejected — it would readmit every sibling container). Empty =
# loopback-only hop-peel. If a reverse proxy sits behind this host's docker
# gateway, set it to that gateway's exact address to keep the chain resolving
# (e.g. 172.18.0.1).
# ROBOFLEET_GUARD_TRUSTED_CHAIN_PEERS=172.18.0.1
# Let return_pattern behavior rules read response bodies, not just status
# codes. Off by default; robo-fleet's own status:404/status:401 rules never need it.
# ROBOFLEET_GUARD_SCAN_RESPONSE_BODY=false

# =============================================================================
# Architectural conventions standard + agent-runtime toolchain matching
# =============================================================================
# Conventions: gates where code lives per-project via .robofleet/conventions.yml.
# ROBOFLEET_CONVENTIONS_ENABLED=false
# Toolchain match: provisions each agent workspace with the TARGET project's
# Python (uv resolves requires-python) and blocks delivery when the suite
# can't be executed, instead of passing on a source-only read. Needs a
# docker socket (local/self-hosted only — off on the GCP Cloud Run path).
# ROBOFLEET_TOOLCHAIN_MATCH_ENABLED=false

# =============================================================================
# External / internal PR review
# =============================================================================
# External: discovers inbound external/fork PRs; the PR reviewer posts one
# READ-ONLY change-request (never runs contributor code).
# ROBOFLEET_EXTERNAL_PR_ENABLED=false
ROBOFLEET_EXTERNAL_PR_REQUIRE_HUMAN_CONFIRM=true
# ROBOFLEET_EXTERNAL_PR_POLL_INTERVAL_SECONDS=300
# ROBOFLEET_EXTERNAL_PR_AUTHOR_ALLOWLIST=["corey"]   # empty = every external PR
# Internal: proactive review pass over RoboFleet's own internal PRs.
# ROBOFLEET_INTERNAL_PR_ENABLED=false

# =============================================================================
# Self-healing CI loop (RoboFleet watching its OWN repo)
# =============================================================================
# On red CI, notifies the CEO and (with originate on) opens a PENDING fix task
# held for the CEO's Approve-&-Start — never self-deploys.
# ROBOFLEET_SELF_HEAL_ENABLED=false
# ROBOFLEET_SELF_HEAL_ORIGINATE_ENABLED=false
# The registered project that IS RoboFleet itself.
# ROBOFLEET_SELF_HEAL_PROJECT_SLUG=robo-fleet
# Scopes the CI signal to one workflow file (RoboFleet has several).
# ROBOFLEET_SELF_HEAL_CI_WORKFLOW=ci.yml

# =============================================================================
# Multi-repo CI-watch / dependency-update bot / gated release manager /
# organizational memory loop / board roadmap engine — all default OFF,
# per-engine bounded + CEO-gated; toggle from Settings -> Feature Flags too.
# =============================================================================
# CI-watch: fan-out self-heal to every opted-in project (projects.ci_watch_enabled).
# ROBOFLEET_CI_WATCH_ENABLED=false
# Dep-update bot: weekly lockfile-diff probe -> "update dependencies" task, only
# for projects with a dep_update_command set.
# ROBOFLEET_DEP_UPDATE_ENABLED=false
# Release manager: deterministic readiness sweep -> ONE release proposal HELD
# for the CEO; the executor publishes only on CEO approval + green CI (reuses
# ROBOFLEET_SELF_HEAL_PROJECT_SLUG as the RoboFleet repo).
# ROBOFLEET_RELEASE_MANAGER_ENABLED=false
# Org-memory loop: distils a completion lesson + auto-injects relevant past
# lessons/playbooks into each claim's briefing (local model only).
# ROBOFLEET_ORG_MEMORY_ENABLED=false
# Board roadmap engine: weekly, opens ONE held exploration task for the Product
# Owner, who proposes a themed cycle of roadmap items for CEO per-item approval.
# ROBOFLEET_ROADMAP_ENGINE_ENABLED=false

# =============================================================================
# Docs-divergence sync (release -> docs-update task)
# =============================================================================
# Master switch for the docs-sync engine. When on, a successful release publish
# originates one bounded, deduped docs-update task against the robo-fleet-website
# project. Requires robo-fleet-website to be registered as a project.
# The build compose defaults this to true; local-dev and registry composes
# default to false. Toggle from Settings → Feature Flags.
# ROBOFLEET_DOCS_SYNC_ENABLED=false
# ROBOFLEET_DOCS_SYNC_MAX_OPEN_TASKS=3
# ROBOFLEET_DOCS_SYNC_MAX_PER_CYCLE=1
# Docs-site identity named in the write_doc(doc_type='user_facing') refusal
# message (robofleet/services/docs.py) — a deployer without their own docs-site
# repo/URL yet can leave these unset for a generic fallback message.
# ROBOFLEET_DOCS_SITE_PROJECT_SLUG=robo-fleet-website
# ROBOFLEET_DOCS_SITE_PUBLIC_URL=docs.robo-fleet.tech

# =============================================================================
# Sandboxed dev DB/Redis/Mongo (per-project opt-in via projects.sandbox_services)
# =============================================================================
# On-demand throwaway sibling containers per agent spawn, replacing the legacy
# prod-creds gate-env injection for an opted-in project. Needs a docker socket
# (local/self-hosted only — off on the GCP Cloud Run path).
# ROBOFLEET_SANDBOX_DB_ENABLED=false

# =============================================================================
# Strategy engine (proactive strategy signals)
# =============================================================================
# ROBOFLEET_STRATEGY_ENGINE_ENABLED=false

# =============================================================================
# Web research
# =============================================================================
# Gives Board/PM roles web_search + web_fetch. INERT (empty results) without a
# provider key — set one to make it live (Tavily / Brave / Exa, per your config).
# ROBOFLEET_RESEARCH_ENABLED=true
# tavily | brave | exa | null — provider adapter for the key below.
# ROBOFLEET_RESEARCH_PROVIDER=tavily
# ROBOFLEET_RESEARCH_API_KEY=

# =============================================================================
# GitHub repository auto-provisioning (pitch -> approve -> auto-provision)
# =============================================================================
# The only place that CREATES GitHub repos. Inert without a token/org set,
# regardless of this flag.
# ROBOFLEET_PROVISIONING_ENABLED=true
# Org-scoped PAT (needs repo + org admin scope) used to create repos.
# ROBOFLEET_PROVISIONING_TOKEN=
# GitHub organization the new repos are provisioned into.
# ROBOFLEET_PROVISIONING_ORG=

# =============================================================================
# Transcript pruning (retention maintenance)
# =============================================================================
# ROBOFLEET_TRANSCRIPT_PRUNE_ENABLED=true

# =============================================================================
# Auditor scheduled sweeps
# =============================================================================
# The orchestrator spawns the auditor on a periodic delivery-process review when
# the interval has elapsed AND recent delivery activity exists. 0 disables.
# ROBOFLEET_AUDIT_INTERVAL_SECONDS=21600

# =============================================================================
# Obsidian vault (org's human-readable memory palace, V1+V2)
# =============================================================================
# Both non-registry compose files default vault ON (ROBOFLEET_VAULT_PATH
# bind-mounted to ${ROBOFLEET_DATA_DIR}/vault). Set false to disable
# materialization entirely.
# ROBOFLEET_OBSIDIAN_VAULT_ENABLED=true
# Root directory the vault materializes into INSIDE the container — must match
# the compose bind mount target (/app/vault); do not change without also
# editing the compose volume line.
# ROBOFLEET_VAULT_PATH=/app/vault
# Watches #robo-fleet-tagged notes in the vault inbox -> board-review drafts.
# ROBOFLEET_VAULT_INTAKE_ENABLED=true
# Move old terminal tasks' notes into RoboFleet/Archive/<year>/ during the weekly
# drift-janitor sweep. 0 disables archival.
# ROBOFLEET_VAULT_ARCHIVE_DAYS=30
# Weekly org-report note (metrics/usage digest) + CEO notification.
# ROBOFLEET_VAULT_REPORT_ENABLED=true
# KB ingest: embeds the CEO's own RoboFleet/Notes/ into the fleet-retrievable
# corpus (robofleet_kb_search, claim-time briefings). Off by default in the
# registry compose; the build compose arms it true.
# ROBOFLEET_VAULT_KB_ENABLED=false
# Comma-separated vault-relative dirs to ingest (must not overlap a reserved
# projection dir — Tasks/Journals/A2A/Agents/Archive/_meta/Reports/.obsidian).
# ROBOFLEET_VAULT_KB_DIRS=RoboFleet/Notes
# Seconds between vault-KB ingest scan cycles.
# ROBOFLEET_VAULT_KB_INTERVAL_SECONDS=900

# =============================================================================
# RoboFleet video engine (bespoke motion-graphics videos)
# =============================================================================
# A UX/UI dev authors a HyperFrames video per release/spotlight/on-demand
# trigger through the normal delivery lifecycle; nothing auto-posts — every
# clip is held for CEO approval. Off by default; the build compose arms it.
# ROBOFLEET_VIDEO_ENGINE_ENABLED=false
# ROBOFLEET_VIDEO_ON_RELEASE=false
# ROBOFLEET_VIDEO_ON_SPOTLIGHT=false

# =============================================================================
# MinIO object storage for rendered videos — build compose only
# =============================================================================
# Decoupled, docker-managed durable copy of rendered MP4s alongside the local-
# disk source of truth. Intentionally OMITTED from docker-compose.registry.yml
# (build-compose default-on, registry default-off — see the minio-data volume
# + minio/minio-init services in docker-compose.yml). Empty endpoint =
# disabled (the media route falls back to local-disk FileResponse); the build
# compose hardcodes the endpoint to the minio container, so only these four
# matter there:
# ROBOFLEET_MINIO_ACCESS_KEY=minio
# ROBOFLEET_MINIO_SECRET_KEY=minio123
# ROBOFLEET_MINIO_BUCKET=robofleet-video-renders
# ROBOFLEET_MINIO_REGION=us-east-1

# =============================================================================
# Fable-mode (behavioral doctrine + turn-discipline/honesty/verification hooks)
# =============================================================================
# Off by default; the build compose arms it as the live test bed. Bundles the
# ponytail build-laziness doctrine on the same flag.
# ROBOFLEET_FABLE_MODE_ENABLED=false
# lite | full | ultra — developer ladder intensity (bundled with fable-mode).
# ROBOFLEET_PONYTAIL_INTENSITY=full

# =============================================================================
# X (Twitter) engine
# =============================================================================
# The engine drafts release posts + mention replies HELD for per-post CEO
# approval; it is INERT until you store the four OAuth 1.0a secrets. Those are
# NOT env vars — enter them in the panel (Settings -> X credentials, stored
# Fernet-encrypted): API key, API secret, access token, access token secret,
# from an X developer app with read+write user-context access.
# ROBOFLEET_X_ENGINE_ENABLED=false
# Optional: pin the account's numeric user id (else it's resolved via /users/me).
# ROBOFLEET_X_ACCOUNT_USER_ID=

# =============================================================================
# CORS (comma-separated origins)
# =============================================================================
ROBOFLEET_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Agent tool-call budget (per session) ---
# Warn/halt thresholds for an agent's tool-call count; the halt gracefully
# stops the container and releases its task back to the pool. Audit-heavy
# tasks (page sweeps, big refactors) need headroom — 600 clears a real
# task's footprint while keeping the runaway guard.
ROBOFLEET_AGENT_TOOL_CALL_WARN=200
ROBOFLEET_AGENT_TOOL_CALL_HALT=600
